# Clave de https://openrouter.ai/keys . Sin clave, la app corre en modo demo.
OPENROUTER_API_KEY=

# Modelos (IDs de OpenRouter)
ORCHESTRATOR_MODEL=anthropic/claude-opus-5.5
# Ojo: la variante "-contributor" es ~12x más barata, pero Meta puede usar prompts y respuestas para entrenar.
# Para datos de clientes, considerá meta/muse-spark-1.3.
RESEARCHER_MODEL=meta/muse-spark-1.3-contributor
# Por defecto el crítico usa el modelo del investigador (distinto al orquestador, a propósito).
# CRITIC_MODEL=

# 1 = los investigadores buscan en la web (plugin web de OpenRouter). 0 = solo conocimiento del modelo.
RESEARCH_WEB=1
# 1 = enviar también las fotos a los investigadores. Por defecto solo las ve el orquestador.
RESEARCHER_VISION=0

# Edición musical (/edicion)
# El "Oído": tiene que aceptar audio como entrada.
# Se puede poner una lista separada por comas: si el primero está saturado (429) se usa el siguiente.
EAR_MODEL=google/gemini-3.8-flash,google/gemini-3.7-flash,qwen/qwen3.8-omni-flash
# El "Director" (orquesta y monta): tiene que aceptar imágenes. Por defecto, el mismo que el orquestador.
# DIRECTOR_MODEL=anthropic/claude-opus-5.5

# Reintentos ante errores pasajeros de OpenRouter (429 del pool compartido, 5xx, cortes de red).
OPENROUTER_RETRIES=3

PORT=3000
